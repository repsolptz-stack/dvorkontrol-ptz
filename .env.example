# Supabase Edge Functions URL. Without this, map loading/publishing is disabled.
VITE_EDGE_BASE=https://your-project.supabase.co/functions/v1

# Optional. Defaults to OpenStreetMap tiles.
# VITE_MAP_TILES_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_MAPTILER_KEY
# VITE_MAP_TILES_ATTRIBUTION=© MapTiler © OpenStreetMap contributors
